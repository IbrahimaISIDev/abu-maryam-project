# Identifiants d'amorçage du compte admin (/admin) — utilisés une seule fois par
# `npm run db:seed-admin` pour créer la ligne dans la table admin_users. Une fois
# ce compte créé, la connexion vérifie le mot de passe haché en base (table
# admin_users), pas ces variables — changer le mot de passe se fait ensuite
# depuis /admin/parametres, plus via ces valeurs.
ADMIN_EMAIL=admin@abumaryam.tv
ADMIN_PASSWORD=change-me

# Secret utilisé pour signer le cookie de session admin (HMAC-SHA256).
# Générer une valeur : openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Chaîne de connexion Postgres (Neon) — Neon Console → Project → Connect →
# copier la "Connection string" (mode pooled).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clé API YouTube Data v3 — nécessaire uniquement pour récupérer la durée
# exacte d'une vidéo depuis l'admin (titre/vignette utilisent l'oEmbed public,
# sans clé). Google Cloud Console → créer un projet → activer "YouTube Data
# API v3" → Identifiants → créer une clé API.
YOUTUBE_API_KEY=change-me

# Origine de base des appels fetch() internes (lib/api-routes.ts). Laisser vide
# pour appeler l'API sur la même origine que le site (cas normal). À renseigner
# uniquement si l'API venait à vivre sur un autre domaine/sous-domaine.
NEXT_PUBLIC_API_BASE_URL=

# URL publique canonique du site (lib/i18n.ts → SITE_URL), utilisée dans le
# sitemap, robots.txt, les métadonnées Open Graph/JSON-LD et les liens de
# partage. À renseigner avec le vrai domaine en production.
NEXT_PUBLIC_SITE_URL=https://abumaryam.tv

# Cloudflare R2 (stockage objet compatible S3) — upload direct des fichiers
# audio/vidéo depuis l'admin (lib/r2.ts). Cloudflare Dashboard → R2 Object
# Storage → créer un bucket, puis "Manage API tokens" → créer un jeton avec
# permissions "Object Read & Write". R2_PUBLIC_URL = l'URL publique du bucket
# (activée dans Settings → Public access) ou un domaine personnalisé.
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=abu-maryam-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
