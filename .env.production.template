# ─────────────────────────────────────────────────────────────────────────────
# .env.production — Secrets de production pour Abu Maryam TV
# ⚠  Ce fichier ne doit JAMAIS être commité (il est dans .gitignore).
#    Copier ce template sur le serveur et remplir toutes les valeurs.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@abumaryam.tv
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Générer avec : openssl rand -hex 32
ADMIN_SESSION_SECRET=CHANGE_ME_32_CHARS_HEX

# ── Base de données (Neon PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ── YouTube API ───────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=CHANGE_ME

# ── Site public ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://abou-maryam.com
NEXT_PUBLIC_API_BASE_URL=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=abu-maryam-media
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
